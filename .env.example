# Environment example for Vite client variables
# Copy to `.env.local` for local development and edit values as needed.
# Note: Vite only exposes variables prefixed with VITE_ to the client.

# API base URL used by the client when `VITE_USE_MOCK` is false.
# Leave this empty to use Vite proxy (`/api/...`) during local development.
# For direct backend calls, set it to `http://localhost:8080`.
VITE_API_BASE_URL=

# Enable mock mode locally. Use "false" to call real APIs (ensure backend is running).
VITE_USE_MOCK=true
VITE_API_BASE_URL=
VITE_WS_URL=

# Toss Payments 클라이언트 키 (API 개별 연동 키, 위젯 키 아님).
# 개발자센터 > API 키 메뉴에서 발급. 미설정 시 Toss 공개 샌드박스 테스트 키로 fallback되며,
# 이 경우 실 결제(운영 배포)는 불가능하다. 운영 전 반드시 실 클라이언트 키로 교체할 것.
VITE_TOSS_CLIENT_KEY=